# Copy to .env beside the compose file, then edit. .env is gitignored.

# ---------------------------------------------------------------- required
# The in-game admin account. The server logs every start argument in clear
# text, so this is worth rotating once the account exists; players change
# their own with /changepwd. Generate one:
#   openssl rand -base64 24 | tr -d '/+=' | head -c 32
ZOMBOID_SERVER_ADMIN_PASSWORD=

# Anyone with this can run any command on the server. Same generator.
ZOMBOID_SERVER_RCON_PASSWORD=

# ---------------------------------------------------------------- the world
# THE SAVE DIRECTORY, NOT A LABEL. The world lives under this name on disk.
# Change it and the server starts a new, empty world, leaving the old one
# orphaned. No spaces, no special characters, or the admin account fails.
ZOMBOID_SERVER_SAVE_NAME=servertest
# The name players see. Safe to change. NO PIPE CHARACTER: the image writes
# settings with sed using | as its delimiter, and a | here makes the write
# silently fail.
ZOMBOID_SERVER_DISPLAY_NAME=Project Zomboid Co-op
ZOMBOID_SERVER_ADMIN_USERNAME=admin
ZOMBOID_SERVER_MAX_PLAYERS=8
# false: not in the public browser. Friends connect by address.
ZOMBOID_SERVER_PUBLIC=false
# Apocalypse, Beginner, Builder, FirstWeek, SixMonthsLater, Survival, Survivor.
# Applied when the world is created; ignored afterwards.
ZOMBOID_SERVER_PRESET=Apocalypse

# ---------------------------------------------------------------- networking
# Both game ports are published under the numbers they bind. 16261 is the
# handshake; 16262 is the direct connection every client is handed after it.
# Forward both, or players connect, wait, and time out.
ZOMBOID_SERVER_PORT=16261
ZOMBOID_SERVER_UDP_PORT=16262
ZOMBOID_SERVER_STEAM_PORT_1=8766
ZOMBOID_SERVER_STEAM_PORT_2=8767

ZOMBOID_SERVER_TIMEZONE=UTC

# ---------------------------------------------------------------- overridable defaults
# Everything below has a working default in the compose file; set it here only
# to change it, and the change survives every git pull.
#
# ZOMBOID_SERVER_IMAGE_VERSION=42.20.4-release@sha256:...
# ZOMBOID_SERVER_IMAGE_TAG=danixu86/project-zomboid-dedicated-server:42.20.4-release
#
# The JVM heap. The world grows as players explore; 8 GB carried a group of
# four for months. The container ceiling below must stay above it.
# ZOMBOID_SERVER_JVM_MIN_MEMORY=4096m
# ZOMBOID_SERVER_JVM_MAX_MEMORY=8192m
#
# 12g is measured: peak 9.5 GB, resident 2.9 GB, and a world that keeps
# growing. The ceiling exists so a leak here cannot get some other container
# killed instead.
# ZOMBOID_SERVER_MEMORY_LIMIT=12g
# ZOMBOID_SERVER_CPU_LIMIT=4.0
# ZOMBOID_SERVER_MEMORY_RESERVATION=4g
# ZOMBOID_SERVER_CPU_RESERVATION=1.0
#
# The first start downloads the game through SteamCMD and loads the world.
# ZOMBOID_SERVER_START_PERIOD=25m
# The world is saved on the way out; a large map needs well over ten seconds.
# ZOMBOID_SERVER_STOP_GRACE_PERIOD=2m
# ZOMBOID_SERVER_LOG_MAX_SIZE=10m
# ZOMBOID_SERVER_LOG_MAX_FILE=3
